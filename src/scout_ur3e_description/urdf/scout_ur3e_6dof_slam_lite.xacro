<?xml version="1.0"?>
<robot name="scout_ur3e_6dof_slam_lite" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_x_size" value="0.925"/>
  <xacro:property name="base_y_size" value="0.380"/>
  <xacro:property name="base_z_size" value="0.210"/>
  <xacro:property name="wheel_radius" value="0.16459"/>
  <xacro:property name="wheel_length" value="0.11653"/>
  <xacro:property name="wheel_separation" value="0.58306"/>
  <xacro:property name="wheelbase" value="0.498"/>
  <xacro:property name="wheel_vertical_offset" value="-0.0702"/>

  <material name="lite_gray">
    <color rgba="0.42 0.44 0.44 1.0"/>
  </material>
  <material name="lite_dark">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>
  <material name="ur_blue">
    <color rgba="0.08 0.24 0.72 1.0"/>
  </material>
  <material name="ur_light">
    <color rgba="0.82 0.84 0.86 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="simple_cylinder_link" params="name radius length mass material *origin">
    <link name="${name}">
      <xacro:box_inertial mass="${mass}" x="${radius * 2.0}" y="${radius * 2.0}" z="${length}"/>
      <visual>
        <xacro:insert_block name="origin"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <xacro:insert_block name="origin"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="name x y">
    <link name="${name}_link">
      <inertial>
        <mass value="1.2"/>
        <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="lite_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_vertical_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>

  <!-- Scout body: primitive-only approximation to keep Gazebo light. -->
  <link name="base_link">
    <xacro:box_inertial mass="45.0" x="${base_x_size}" y="${base_y_size}" z="${base_z_size}"/>
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
      <material name="lite_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${-(wheel_vertical_offset - wheel_radius)}" rpy="0 0 0"/>
  </joint>

  <xacro:drive_wheel name="front_left_wheel" x="${wheelbase / 2.0}" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel name="front_right_wheel" x="${wheelbase / 2.0}" y="${-wheel_separation / 2.0}"/>
  <xacro:drive_wheel name="rear_left_wheel" x="${-wheelbase / 2.0}" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel name="rear_right_wheel" x="${-wheelbase / 2.0}" y="${-wheel_separation / 2.0}"/>

  <link name="ur_control_box_link">
    <xacro:box_inertial mass="3.0" x="0.35" y="0.40" z="0.30"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.40 0.30"/>
      </geometry>
      <material name="lite_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.40 0.30"/>
      </geometry>
    </collision>
  </link>
  <joint name="ur_control_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ur_control_box_link"/>
    <origin xyz="-0.15 0.005 0.26" rpy="0 0 0"/>
  </joint>

  <!-- Six-axis UR3e-style kinematic chain with lightweight visuals. -->
  <xacro:simple_cylinder_link name="ur3e_base_link" radius="0.075" length="0.10" mass="2.0" material="ur_light">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </xacro:simple_cylinder_link>
  <joint name="ur3e_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ur3e_base_link"/>
    <origin xyz="0.25 0 0.10" rpy="0 0 0"/>
  </joint>

  <xacro:simple_cylinder_link name="ur3e_shoulder_link" radius="0.070" length="0.12" mass="1.8" material="ur_blue">
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </xacro:simple_cylinder_link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="ur3e_base_link"/>
    <child link="ur3e_shoulder_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="150" velocity="3.14"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <link name="ur3e_upper_arm_link">
    <xacro:box_inertial mass="2.0" x="0.27" y="0.08" z="0.08"/>
    <visual>
      <origin xyz="0.135 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.27"/>
      </geometry>
      <material name="ur_light"/>
    </visual>
    <collision>
      <origin xyz="0.135 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.27"/>
      </geometry>
    </collision>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="ur3e_shoulder_link"/>
    <child link="ur3e_upper_arm_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="0.7854" effort="150" velocity="3.14"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <link name="ur3e_forearm_link">
    <xacro:box_inertial mass="1.6" x="0.24" y="0.07" z="0.07"/>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.24"/>
      </geometry>
      <material name="ur_light"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0" rpy="0 ${pi / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.24"/>
      </geometry>
    </collision>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="ur3e_upper_arm_link"/>
    <child link="ur3e_forearm_link"/>
    <origin xyz="0.27 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.80" upper="2.80" effort="100" velocity="3.14"/>
    <dynamics damping="0.35" friction="0.1"/>
  </joint>

  <xacro:simple_cylinder_link name="ur3e_wrist_1_link" radius="0.038" length="0.10" mass="0.7" material="ur_blue">
    <origin xyz="0.05 0 0" rpy="0 ${pi / 2.0} 0"/>
  </xacro:simple_cylinder_link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="ur3e_forearm_link"/>
    <child link="ur3e_wrist_1_link"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="54" velocity="6.28"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <xacro:simple_cylinder_link name="ur3e_wrist_2_link" radius="0.036" length="0.09" mass="0.6" material="ur_light">
    <origin xyz="0.045 0 0" rpy="0 ${pi / 2.0} 0"/>
  </xacro:simple_cylinder_link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="ur3e_wrist_1_link"/>
    <child link="ur3e_wrist_2_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="54" velocity="6.28"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <xacro:simple_cylinder_link name="ur3e_wrist_3_link" radius="0.034" length="0.08" mass="0.5" material="ur_blue">
    <origin xyz="0.04 0 0" rpy="0 ${pi / 2.0} 0"/>
  </xacro:simple_cylinder_link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="ur3e_wrist_2_link"/>
    <child link="ur3e_wrist_3_link"/>
    <origin xyz="0.09 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2.0 * pi}" upper="${2.0 * pi}" effort="54" velocity="6.28"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="ur3e_flange"/>
  <joint name="ur3e_flange_joint" type="fixed">
    <parent link="ur3e_wrist_3_link"/>
    <child link="ur3e_flange"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
  </joint>

  <link name="ur3e_tool0"/>
  <joint name="ur3e_tool0_joint" type="fixed">
    <parent link="ur3e_flange"/>
    <child link="ur3e_tool0"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>

  <link name="robotiq_85_base_link">
    <xacro:box_inertial mass="0.6" x="0.09" y="0.10" z="0.055"/>
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.10 0.055"/>
      </geometry>
      <material name="lite_dark"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.10 0.055"/>
      </geometry>
    </collision>
  </link>
  <joint name="robotiq_85_base_joint" type="fixed">
    <parent link="ur3e_tool0"/>
    <child link="robotiq_85_base_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="finger" params="side y">
    <link name="robotiq_85_${side}_finger_link">
      <xacro:box_inertial mass="0.08" x="0.11" y="0.018" z="0.022"/>
      <visual>
        <origin xyz="0.095 ${y} 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.11 0.018 0.022"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <origin xyz="0.095 ${y} 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.11 0.018 0.022"/>
        </geometry>
      </collision>
    </link>
    <joint name="robotiq_85_${side}_finger_joint" type="fixed">
      <parent link="robotiq_85_base_link"/>
      <child link="robotiq_85_${side}_finger_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:finger side="left" y="0.043"/>
  <xacro:finger side="right" y="-0.043"/>

  <link name="button_press_tip"/>
  <joint name="button_press_tip_joint" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="button_press_tip"/>
    <origin xyz="0.16 0 0" rpy="0 0 0"/>
  </joint>

  <link name="velodyne_link">
    <xacro:box_inertial mass="0.5" x="0.11" y="0.11" z="0.08"/>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.08"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne_link"/>
    <origin xyz="0.38 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="realsense_d435i_link">
    <xacro:box_inertial mass="0.09" x="0.09" y="0.025" z="0.025"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="realsense_d435i_joint" type="fixed">
    <parent link="ur3e_flange"/>
    <child link="realsense_d435i_link"/>
    <origin xyz="-0.025 0 -0.045" rpy="0 ${pi} ${pi}"/>
  </joint>

  <link name="realsense_d435i_color_optical_frame"/>
  <joint name="realsense_d435i_color_optical_joint" type="fixed">
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <link name="realsense_d435i_depth_optical_frame"/>
  <joint name="realsense_d435i_depth_optical_joint" type="fixed">
    <parent link="realsense_d435i_link"/>
    <child link="realsense_d435i_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <gazebo reference="ur_control_box_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_base_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_shoulder_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_upper_arm_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_forearm_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_wrist_1_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_wrist_2_link"><gravity>false</gravity></gazebo>
  <gazebo reference="ur3e_wrist_3_link"><gravity>false</gravity></gazebo>
  <gazebo reference="robotiq_85_base_link"><gravity>false</gravity></gazebo>
  <gazebo reference="robotiq_85_left_finger_link"><gravity>false</gravity></gazebo>
  <gazebo reference="robotiq_85_right_finger_link"><gravity>false</gravity></gazebo>
  <gazebo reference="realsense_d435i_link"><gravity>false</gravity></gazebo>

  <gazebo>
    <plugin name="arm_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/</namespace>
        <remapping>set_joint_trajectory:=arm_joint_trajectory</remapping>
      </ros>
      <update_rate>50</update_rate>
    </plugin>

    <plugin name="scout_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>30.0</max_wheel_torque>
      <max_wheel_acceleration>2.5</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="velodyne_link">
    <sensor name="velodyne_laser" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="velodyne_laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>velodyne_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="realsense_d435i_link">
    <sensor name="realsense_color" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="realsense_color_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=color/image_raw</remapping>
          <remapping>camera_info:=color/camera_info</remapping>
        </ros>
        <camera_name>realsense_d435i</camera_name>
        <frame_name>realsense_d435i_color_optical_frame</frame_name>
      </plugin>
    </sensor>

  </gazebo>

</robot>
