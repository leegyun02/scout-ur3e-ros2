<?xml version="1.0"?>
<robot name="scout_ur3e" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="odometry_source" default="ground_truth"/>
  <!-- Wheel macros read this global argument.  The Scout macro itself is
       still called with load_gazebo=false so only our Fortress plugins load. -->
  <xacro:arg name="load_gazebo" default="true"/>
  <xacro:property name="scout_track" value="0.58306"/>
  <xacro:property name="scout_wheel_radius" value="0.16459"/>

  <!-- Reuse the proven Scout chassis, but provide Fortress-native plugins below. -->
  <xacro:include filename="$(find agilex_scout)/urdf/mobile_robot/scout_v2.urdf.xacro"/>
  <xacro:scout_v2 odometry_source="$(arg odometry_source)" load_gazebo="false"/>

  <!-- Use the vendor descriptions so link geometry, inertias and joint limits
       match a UR3e + Robotiq 2F-85 instead of the former navigation mock-up. -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <material name="sensor_black"><color rgba="0.015 0.015 0.02 1"/></material>
  <material name="control_dark"><color rgba="0.10 0.11 0.13 1"/></material>

  <xacro:macro name="box_link" params="name size mass material">
    <link name="${name}">
      <inertial><mass value="${mass}"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
      <visual><geometry><box size="${size}"/></geometry><material name="${material}"/></visual>
      <collision><geometry><box size="${size}"/></geometry></collision>
    </link>
  </xacro:macro>

  <xacro:macro name="cylinder_link" params="name radius length mass material *origin">
    <link name="${name}">
      <inertial><mass value="${mass}"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
      <visual><xacro:insert_block name="origin"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry><material name="${material}"/></visual>
      <collision><xacro:insert_block name="origin"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
    </link>
  </xacro:macro>

  <!-- UR controller cabinet and mechanical mounting plate. -->
  <xacro:box_link name="ur_control_box_link" size="0.34 0.34 0.27" mass="3.0" material="control_dark"/>
  <joint name="ur_control_box_joint" type="fixed">
    <parent link="mobile_robot_base_link"/><child link="ur_control_box_link"/>
    <origin xyz="-0.16 0 0.23" rpy="0 0 0"/>
  </joint>

  <xacro:box_link name="ur_mount_link" size="0.18 0.22 0.08" mass="2.0" material="control_dark"/>
  <joint name="ur_mount_joint" type="fixed">
    <parent link="mobile_robot_base_link"/><child link="ur_mount_link"/>
    <origin xyz="0.18 0 0.145" rpy="0 0 0"/>
  </joint>

  <xacro:ur_robot
    name="ur3e"
    tf_prefix="ur3e_"
    parent="ur_mount_link"
    joint_limits_parameters_file="$(find ur_description)/config/ur3e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur3e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur3e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur3e/visual_parameters.yaml"
    generate_ros2_control_tag="false">
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Actual Robotiq CAD visuals in a rigid open pose. Fortress 6 does not
       enforce URDF mimic joints and the free linkage becomes unstable, so
       finger actuation is intentionally deferred to the manipulation stage. -->
  <link name="gripper_robotiq_85_base_link">
    <inertial><mass value="0.90"/><origin xyz="0 0 0.05"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.001"/></inertial>
    <visual name="base"><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/robotiq_base.dae"/></geometry></visual>
    <visual name="left_knuckle"><origin xyz="0.03060114 0 0.05490452"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/left_knuckle.dae"/></geometry></visual>
    <visual name="right_knuckle"><origin xyz="-0.03060114 0 0.05490452"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/right_knuckle.dae"/></geometry></visual>
    <visual name="left_finger"><origin xyz="0.06212730 0 0.05114105"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/left_finger.dae"/></geometry></visual>
    <visual name="right_finger"><origin xyz="-0.06212730 0 0.05114105"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/right_finger.dae"/></geometry></visual>
    <visual name="left_inner"><origin xyz="0.0127 0 0.06142"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/left_inner_knuckle.dae"/></geometry></visual>
    <visual name="right_inner"><origin xyz="-0.0127 0 0.06142"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/right_inner_knuckle.dae"/></geometry></visual>
    <visual name="left_tip"><origin xyz="0.06775864 0 0.09832620"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/left_finger_tip.dae"/></geometry></visual>
    <visual name="right_tip"><origin xyz="-0.06775864 0 0.09832620"/><geometry><mesh filename="file://$(find robotiq_description)/meshes/visual/right_finger_tip.dae"/></geometry></visual>
    <collision name="base_collision"><origin xyz="0 0 0.032"/><geometry><cylinder radius="0.055" length="0.064"/></geometry></collision>
    <collision name="fingers_collision"><origin xyz="0 0 0.105"/><geometry><box size="0.155 0.045 0.11"/></geometry></collision>
  </link>
  <joint name="gripper_robotiq_85_base_joint" type="fixed">
    <parent link="ur3e_tool0"/><child link="gripper_robotiq_85_base_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 ${pi / 2.0}"/>
  </joint>

  <!-- Wrist-mounted D435i.  It follows the arm and provides RGB images for
       later object detection / pick-and-place work. -->
  <xacro:sensor_d435i parent="ur3e_flange" name="wrist_camera" use_nominal_extrinsics="true">
    <!-- Compensate the +90 degree default wrist_3 pose so the camera remains
         at the 12 o'clock mounting position while the gripper is rotated. -->
    <origin xyz="-0.01 -0.035 0" rpy="${pi / 2.0} 0 0"/>
  </xacro:sensor_d435i>

  <!-- VLP-16-sized sensor, mounted at the front to keep most of the field of
       view clear of the stowed arm and control box. -->
  <xacro:cylinder_link name="velodyne_link" radius="0.052" length="0.075" mass="0.83" material="sensor_black">
    <origin xyz="0 0 0.0375" rpy="0 0 0"/>
  </xacro:cylinder_link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="mobile_robot_base_link"/><child link="velodyne_link"/>
    <origin xyz="0.37 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="mobile_robot_base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Fortress systems. -->
  <gazebo>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Fortress-native controller. ROS /arm_joint_trajectory is bridged to
         this endpoint, so no gz_ros2_control installation is required. -->
    <plugin filename="libignition-gazebo6-joint-trajectory-controller-system.so"
            name="ignition::gazebo::systems::JointTrajectoryController">
      <topic>/scout/arm_joint_trajectory</topic>
      <joint_name>ur3e_shoulder_pan_joint</joint_name><initial_position>0.0</initial_position>
      <position_p_gain>1200</position_p_gain><position_d_gain>80</position_d_gain>
      <joint_name>ur3e_shoulder_lift_joint</joint_name><initial_position>-1.5708</initial_position>
      <position_p_gain>1600</position_p_gain><position_d_gain>100</position_d_gain>
      <joint_name>ur3e_elbow_joint</joint_name><initial_position>1.5708</initial_position>
      <position_p_gain>1400</position_p_gain><position_d_gain>90</position_d_gain>
      <joint_name>ur3e_wrist_1_joint</joint_name><initial_position>-1.5708</initial_position>
      <position_p_gain>700</position_p_gain><position_d_gain>45</position_d_gain>
      <joint_name>ur3e_wrist_2_joint</joint_name><initial_position>-1.5708</initial_position>
      <position_p_gain>500</position_p_gain><position_d_gain>35</position_d_gain>
      <joint_name>ur3e_wrist_3_joint</joint_name><initial_position>${pi / 2.0}</initial_position>
      <position_p_gain>350</position_p_gain><position_d_gain>25</position_d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <wheel_separation>${scout_track}</wheel_separation>
      <wheel_radius>${scout_wheel_radius}</wheel_radius>
      <topic>/scout/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>1.2</max_angular_acceleration>
      <min_angular_acceleration>-1.2</min_angular_acceleration>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
    </plugin>

    <!-- Ground truth odometry is intentional for the first SLAM/Nav2 stage.
         It can later be swapped for wheel + IMU fusion without changing APIs. -->
    <plugin filename="libignition-gazebo6-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/scout/odometry</odom_topic>
      <tf_topic>/scout/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <gaussian_noise>0.002</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo reference="velodyne_link">
    <sensor name="velodyne_vlp16" type="gpu_lidar">
      <topic>/scout/velodyne</topic>
      <update_rate>10</update_rate>
      <ignition_frame_id>velodyne_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal><samples>900</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical>
        </scan>
        <range><min>0.40</min><max>50.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="scout_imu" type="imu">
      <topic>/scout/imu</topic><update_rate>100</update_rate>
      <ignition_frame_id>imu_link</ignition_frame_id><always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="wrist_camera_color_frame">
    <sensor name="wrist_rgb_camera" type="camera">
      <topic>/scout/wrist_camera/image_raw</topic>
      <update_rate>20</update_rate>
      <ignition_frame_id>wrist_camera_color_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.08</near><far>10.0</far></clip>
      </camera>
      <always_on>true</always_on><visualize>false</visualize>
    </sensor>
  </gazebo>
</robot>
