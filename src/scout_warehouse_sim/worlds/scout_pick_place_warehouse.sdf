<?xml version="1.0"?>
<sdf version="1.8">
  <world name="scout_pick_place_warehouse">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.12 0.14 0.17 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="warehouse_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.25 0.15 -1.0</direction>
    </light>
    <light name="ceiling_light_north" type="point">
      <pose>0 4.5 5.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="ceiling_light_south" type="point">
      <pose>0 -4.5 5.5 0 0 0</pose><diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>25</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- 23 x 17 m enclosed warehouse shell. -->
    <model name="warehouse_shell">
      <static>true</static>
      <link name="shell">
        <collision name="floor_collision"><pose>0 0 -0.10 0 0 0</pose><geometry><box><size>23 17 0.20</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 -0.10 0 0 0</pose><geometry><box><size>23 17 0.20</size></box></geometry><material><ambient>0.42 0.43 0.44 1</ambient><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>

        <collision name="wall_west_collision"><pose>-11.5 0 2.0 0 0 0</pose><geometry><box><size>0.20 17 4.0</size></box></geometry></collision>
        <visual name="wall_west_visual"><pose>-11.5 0 2.0 0 0 0</pose><geometry><box><size>0.20 17 4.0</size></box></geometry><material><ambient>0.72 0.73 0.75 1</ambient><diffuse>0.82 0.83 0.85 1</diffuse></material></visual>
        <collision name="wall_east_collision"><pose>11.5 0 2.0 0 0 0</pose><geometry><box><size>0.20 17 4.0</size></box></geometry></collision>
        <visual name="wall_east_visual"><pose>11.5 0 2.0 0 0 0</pose><geometry><box><size>0.20 17 4.0</size></box></geometry><material><ambient>0.72 0.73 0.75 1</ambient><diffuse>0.82 0.83 0.85 1</diffuse></material></visual>
        <collision name="wall_north_collision"><pose>0 8.5 2.0 0 0 0</pose><geometry><box><size>23 0.20 4.0</size></box></geometry></collision>
        <visual name="wall_north_visual"><pose>0 8.5 2.0 0 0 0</pose><geometry><box><size>23 0.20 4.0</size></box></geometry><material><ambient>0.72 0.73 0.75 1</ambient><diffuse>0.82 0.83 0.85 1</diffuse></material></visual>
        <collision name="wall_south_collision"><pose>0 -8.5 2.0 0 0 0</pose><geometry><box><size>23 0.20 4.0</size></box></geometry></collision>
        <visual name="wall_south_visual"><pose>0 -8.5 2.0 0 0 0</pose><geometry><box><size>23 0.20 4.0</size></box></geometry><material><ambient>0.72 0.73 0.75 1</ambient><diffuse>0.82 0.83 0.85 1</diffuse></material></visual>

        <!-- Yellow perimeter and aisle markings. -->
        <visual name="center_aisle_left"><pose>-0.75 0 0.006 0 0 0</pose><geometry><box><size>0.06 15.0 0.01</size></box></geometry><material><ambient>0.95 0.72 0.03 1</ambient><diffuse>1.0 0.82 0.04 1</diffuse></material></visual>
        <visual name="center_aisle_right"><pose>0.75 0 0.006 0 0 0</pose><geometry><box><size>0.06 15.0 0.01</size></box></geometry><material><ambient>0.95 0.72 0.03 1</ambient><diffuse>1.0 0.82 0.04 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Central pallet racks leave a wide loop and a center aisle for Nav2. -->
    <include><uri>model://warehouse_rack</uri><name>rack_west_north</name><pose>-2.4 3.5 0 0 0 0</pose></include>
    <include><uri>model://warehouse_rack</uri><name>rack_west_south</name><pose>-2.4 -3.5 0 0 0 0</pose></include>
    <include><uri>model://warehouse_rack</uri><name>rack_east_north</name><pose>2.4 3.5 0 0 0 0</pose></include>
    <include><uri>model://warehouse_rack</uri><name>rack_east_south</name><pose>2.4 -3.5 0 0 0 0</pose></include>

    <!-- Four 0.57 m workcells. Left cells face east, right cells face west. -->
    <include><uri>model://workcell_table</uri><name>workcell_A_table</name><pose>-8.0 5.0 0 0 0 0</pose></include>
    <include><uri>model://workcell_table</uri><name>workcell_B_table</name><pose>-8.0 -5.0 0 0 0 0</pose></include>
    <include><uri>model://workcell_table</uri><name>workcell_C_table</name><pose>8.0 5.0 0 0 0 3.14159</pose></include>
    <include><uri>model://workcell_table</uri><name>workcell_D_table</name><pose>8.0 -5.0 0 0 0 3.14159</pose></include>

    <!-- Colored 3 x 3 m floor zones identify A(red), B(blue), C(green), D(amber). -->
    <model name="zone_A_floor"><static>true</static><pose>-8.0 5.0 0.008 0 0 0</pose><link name="zone"><visual name="visual"><geometry><box><size>3.0 3.0 0.012</size></box></geometry><material><ambient>0.55 0.06 0.06 0.45</ambient><diffuse>0.90 0.12 0.12 0.45</diffuse></material><transparency>0.45</transparency></visual></link></model>
    <model name="zone_B_floor"><static>true</static><pose>-8.0 -5.0 0.008 0 0 0</pose><link name="zone"><visual name="visual"><geometry><box><size>3.0 3.0 0.012</size></box></geometry><material><ambient>0.05 0.18 0.60 0.45</ambient><diffuse>0.10 0.30 0.95 0.45</diffuse></material><transparency>0.45</transparency></visual></link></model>
    <model name="zone_C_floor"><static>true</static><pose>8.0 5.0 0.008 0 0 0</pose><link name="zone"><visual name="visual"><geometry><box><size>3.0 3.0 0.012</size></box></geometry><material><ambient>0.04 0.48 0.10 0.45</ambient><diffuse>0.10 0.80 0.20 0.45</diffuse></material><transparency>0.45</transparency></visual></link></model>
    <model name="zone_D_floor"><static>true</static><pose>8.0 -5.0 0.008 0 0 0</pose><link name="zone"><visual name="visual"><geometry><box><size>3.0 3.0 0.012</size></box></geometry><material><ambient>0.65 0.35 0.03 0.45</ambient><diffuse>0.98 0.62 0.05 0.45</diffuse></material><transparency>0.45</transparency></visual></link></model>

    <!-- Dynamic objects are separate entities, ready for a future attach/grasp plugin. -->
    <include><uri>model://pick_box</uri><name>A_red_box_1</name><pose>-7.95 4.72 0.62 0 0 0.20</pose></include>
    <include><uri>model://pick_cylinder</uri><name>A_blue_cylinder_1</name><pose>-7.95 5.18 0.635 0 0 0</pose></include>
    <include><uri>model://pick_box</uri><name>B_red_box_1</name><pose>-7.95 -5.20 0.62 0 0 -0.35</pose></include>
    <include><uri>model://pick_cylinder</uri><name>B_blue_cylinder_1</name><pose>-7.95 -4.72 0.635 0 0 0</pose></include>
    <include><uri>model://pick_box</uri><name>C_red_box_1</name><pose>7.95 5.20 0.62 0 0 0.15</pose></include>
    <include><uri>model://pick_cylinder</uri><name>C_blue_cylinder_1</name><pose>7.95 4.72 0.635 0 0 0</pose></include>
    <include><uri>model://pick_box</uri><name>D_red_box_1</name><pose>7.95 -4.72 0.62 0 0 -0.20</pose></include>
    <include><uri>model://pick_cylinder</uri><name>D_blue_cylinder_1</name><pose>7.95 -5.20 0.635 0 0 0</pose></include>

    <!-- Small pallet stacks make the map less symmetric and improve SLAM loop closure. -->
    <model name="pallet_stack_north"><static>true</static><pose>5.4 6.8 0 0 0 0.15</pose><link name="stack"><collision name="collision"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>1.1 1.2 1.1</size></box></geometry></collision><visual name="visual"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>1.1 1.2 1.1</size></box></geometry><material><ambient>0.38 0.22 0.10 1</ambient><diffuse>0.58 0.34 0.13 1</diffuse></material></visual></link></model>
    <model name="pallet_stack_south"><static>true</static><pose>-5.2 -6.8 0 0 0 -0.25</pose><link name="stack"><collision name="collision"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>1.4 0.9 0.84</size></box></geometry></collision><visual name="visual"><pose>0 0 0.42 0 0 0</pose><geometry><box><size>1.4 0.9 0.84</size></box></geometry><material><ambient>0.18 0.34 0.52 1</ambient><diffuse>0.25 0.46 0.68 1</diffuse></material></visual></link></model>

    <gui fullscreen="false">
      <camera name="warehouse_overview">
        <pose>15 -17 16 0 0.58 2.30</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
